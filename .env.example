# Порт сервиса на хосте (для проверяющей системы — 80)
PII_PORT=8000

# URL подключения к Redis
PII_REDIS_URL=redis://localhost:6379/0

# Ключ шифрования (base64 от 32 байт).
# Генерация: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PII_ENCRYPTION_KEY=

# Ключ HMAC (base64 от 32 байт).
# Генерация: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PII_HMAC_KEY=

# Время жизни соответствий в кэше (секунды)
PII_MAPPING_TTL_SECONDS=1800

# Уровень логирования
PII_LOG_LEVEL=INFO

# Количество воркеров gunicorn
WEB_CONCURRENCY=4

# Сколько запросов один воркер обрабатывает одновременно; сверх лимита — 429 с Retry-After
PII_MAX_CONCURRENT_PROCESS=100

# Максимальный суммарный объём текста в обработке на воркер; сверх лимита — 429 с Retry-After
PII_MAX_INFLIGHT_CHARS=600000

# Значение заголовка Retry-After в ответе 429 (секунды)
PII_RETRY_AFTER_SECONDS=1

# Базовый URL LLM-провайдера.
# Если PII_LLM_BASE_URL пустой, используется встроенная заглушка LLM.
PII_LLM_BASE_URL=

# API-ключ LLM-провайдера
PII_LLM_API_KEY=

# Модель LLM
PII_LLM_MODEL=

# Таймаут запроса к LLM (секунды)
PII_LLM_TIMEOUT_SECONDS=30

# Включить NER-модель (второй этап распознавания после правил)
PII_NER_ENABLED=false

# Модель NER для распознавания ФИО и адресов
PII_NER_MODEL=LLAIMlegal/ru-legal-ner

# Потоков для инференса модели
PII_NER_THREADS=1

# Максимальная длина текста, передаваемого в модель (символов)
PII_NER_MAX_CHARS=2000

# Одновременных запросов к модели
PII_NER_CONCURRENCY=1

# Сколько миллисекунд ждать свободного слота модели; не дождались — текст обрабатывается только правилами
PII_NER_WAIT_MS=20